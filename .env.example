# Neon Postgres. Pooled URL for the app, direct URL for migrations (drizzle-kit).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. http://localhost:3000
BETTER_AUTH_URL=

# Optional: LLM-assisted score parsing. Without it the rating falls back to the deterministic path.
OPENROUTER_API_KEY=
