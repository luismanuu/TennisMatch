# Copy this file to `.env` and fill in the values.
#
# Notes:
# - Do NOT commit your real `.env` file.
# - Server-only secrets (Clerk secret key, Supabase service role key) must NEVER be exposed to the client.
#
# Required for local dev (validated at server startup)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Clerk
# Public key (safe to expose to client). Used by `@clerk/nuxt` for auth UI.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Server secret key (required). Must start with "sk_".
NUXT_CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional: App/site URL used in some server utilities + scripts
# (e.g. invitation links). Defaults to http://localhost:3000
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: LLM fallback scoring (OpenRouter)
OPENROUTER_API_KEY=

# Optional: Prisma / direct Postgres connection string (see `prisma/README.md`)
DATABASE_URL=

# ---- Test / tooling (optional) ----
# Playwright base URL override (default: http://localhost:3000)
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
#
# Vitest: run real Clerk API integration tests (default: mocked)
# VITEST_RUN_REAL_API=true
#
# Optional script overrides
# BASE_URL=http://localhost:3000
# API_URL=http://localhost:3000

