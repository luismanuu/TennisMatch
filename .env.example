# Neon Postgres. Pooled URL for the app, direct URL for migrations (drizzle-kit).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth. Generate the secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. http://localhost:3000. Outbound links (invitations, verification) are built
# from it, never from the request Host. Production requires it (or Vercel's production domain) or refuses to boot.
BETTER_AUTH_URL=

# Email (Resend). Optional on previews and locally: without them sign-up does not require verification.
# Production (NODE_ENV=production on Vercel production or on any non-Vercel host) refuses to boot without both.
RESEND_API_KEY=
EMAIL_FROM=

# Local only: lets `node .output/server/index.mjs` boot without an email sender or pinned URL. Ignored on Vercel.
# ALLOW_UNSAFE_LOCAL_PRODUCTION=1

# Optional: LLM-assisted score parsing. Without it the rating falls back to the deterministic path.
OPENROUTER_API_KEY=
