// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  players     Player[]

  @@index([order], map: "idx_categories_order")
  @@map("categories")
}

model Player {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId     String    @unique @map("clerk_id")
  name        String
  phoneNumber String?   @map("phone_number")
  categoryId  String?   @map("category_id") @db.Uuid
  elo         Int       @default(1000)
  status      String    @default("active") @db.Text
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([clerkId], map: "idx_players_clerk_id")
  @@index([categoryId], map: "idx_players_category_id")
  @@index([status], map: "idx_players_status")
  @@index([deletedAt], map: "idx_players_deleted_at")
  @@map("players")
}
