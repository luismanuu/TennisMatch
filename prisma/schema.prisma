// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  order       Int      @default(0)
  defaultElo  Int      @default(1000) @map("default_elo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  players     Player[]

  @@index([order], map: "idx_categories_order")
  @@map("categories")
}

model City {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  players            Player[]
  citySegmentCities  CitySegmentCity[]

  @@index([order], map: "idx_cities_order")
  @@map("cities")
}

model Player {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId                    String    @unique @map("clerk_id")
  name                       String
  phoneNumber                String?   @map("phone_number")
  cityId                     String?   @map("city_id") @db.Uuid
  categoryId                 String?   @map("category_id") @db.Uuid
  elo                        Int       @default(1000)
  mmr                        Decimal   @default(0.0) @db.Decimal(6, 3)
  mmrUncertainty             Decimal   @default(2.0) @map("mmr_uncertainty") @db.Decimal(4, 2)
  placementMatchesCompleted  Int       @default(0) @map("placement_matches_completed")
  winStreak                  Int       @default(0) @map("win_streak")
  lossStreak                 Int       @default(0) @map("loss_streak")
  lastMatchAt                DateTime? @map("last_match_at") @db.Timestamptz(6)
  matchesThisMonth           Int       @default(0) @map("matches_this_month")
  lastDecayCheck             DateTime? @map("last_decay_check") @db.Date
  totalMatchesPlayed         Int       @default(0) @map("total_matches_played")
  utrRating                  Decimal?  @map("utr_rating") @db.Decimal(10, 2)
  utrReliability             Decimal?  @map("utr_reliability") @db.Decimal(4, 3)
  status                     String    @default("active") @db.Text
  deletedAt                  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  category       Category?       @relation(fields: [categoryId], references: [id])
  city           City?           @relation(fields: [cityId], references: [id])
  ratingHistory  RatingHistory[]

  @@index([clerkId], map: "idx_players_clerk_id")
  @@index([categoryId], map: "idx_players_category_id")
  @@index([cityId], map: "idx_players_city_id")
  @@index([status], map: "idx_players_status")
  @@index([deletedAt], map: "idx_players_deleted_at")
  @@index([mmr], map: "idx_players_mmr")
  @@index([cityId, mmr], map: "idx_players_city_id_mmr")
  @@index([lastMatchAt(sort: Desc)], map: "idx_players_last_match_at")
  @@index([elo], map: "idx_players_elo")
  @@index([totalMatchesPlayed], map: "idx_players_total_matches")
  @@index([utrRating], map: "idx_players_utr_rating")
  @@map("players")
}

model CitySegment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  citySegmentCities CitySegmentCity[]

  @@map("city_segments")
}

model CitySegmentCity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  citySegmentId String   @map("city_segment_id") @db.Uuid
  cityId        String   @map("city_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  
  citySegment CitySegment @relation(fields: [citySegmentId], references: [id], onDelete: Cascade)
  city        City        @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([citySegmentId, cityId])
  @@index([cityId], map: "idx_city_segment_cities_city")
  @@index([citySegmentId], map: "idx_city_segment_cities_segment")
  @@map("city_segment_cities")
}

model RatingHistory {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId           String    @map("player_id") @db.Uuid
  matchId            String    @map("match_id") @db.Uuid
  eloBefore          Int       @map("elo_before")
  eloAfter           Int       @map("elo_after")
  eloChange          Int       @map("elo_change")
  mmrBefore          Decimal   @map("mmr_before") @db.Decimal(6, 3)
  mmrAfter           Decimal   @map("mmr_after") @db.Decimal(6, 3)
  mmrChange          Decimal   @map("mmr_change") @db.Decimal(6, 3)
  uncertaintyBefore  Decimal   @map("uncertainty_before") @db.Decimal(4, 2)
  uncertaintyAfter   Decimal   @map("uncertainty_after") @db.Decimal(4, 2)
  kFactor            Int       @map("k_factor")
  expectedScore      Decimal   @map("expected_score") @db.Decimal(4, 3)
  actualScore        Decimal   @map("actual_score") @db.Decimal(4, 3)
  isPlacementMatch   Boolean   @default(false) @map("is_placement_match")
  isUnratedMatch     Boolean   @default(false) @map("is_unrated_match")
  winStreakBonus     Int       @default(0) @map("win_streak_bonus")
  opponentId         String?   @map("opponent_id") @db.Uuid
  opponentElo        Int?      @map("opponent_elo")
  opponentMmr        Decimal?  @map("opponent_mmr") @db.Decimal(6, 3)
  wasWinner          Boolean   @map("was_winner")
  ratingReversed     Boolean   @default(false) @map("rating_reversed")
  reversedAt         DateTime? @map("reversed_at") @db.Timestamptz(6)
  matchRating        Decimal?  @map("match_rating") @db.Decimal(10, 2)
  matchWeight        Decimal?  @map("match_weight") @db.Decimal(4, 3)
  gamesWon           Int?      @map("games_won")
  gamesLost           Int?      @map("games_lost")
  totalGames          Int?      @map("total_games")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt(sort: Desc)], map: "idx_rating_history_player")
  @@index([matchId], map: "idx_rating_history_match")
  @@index([createdAt(sort: Desc)], map: "idx_rating_history_created")
  @@index([matchRating], map: "idx_rating_history_match_rating")
  @@index([matchWeight], map: "idx_rating_history_match_weight")
  @@map("rating_history")
}
