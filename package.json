{
  "name": "tennis-match",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck:server": "nuxt prepare && tsc --noEmit -p .nuxt/tsconfig.server.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run tests/integration",
    "test:integration:ui": "vitest --ui",
    "test:integration:real-api": "cross-env VITEST_RUN_REAL_API=true vitest run tests/integration/clerk-real-api.spec.ts",
    "test:all": "npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@clerk/localizations": "^3.32.1",
    "@clerk/nuxt": "^1.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@nuxt/ui": "^2.18.0",
    "@supabase/supabase-js": "^2.39.0",
    "bracketry": "^1.1.3",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.2.2",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@clerk/clerk-sdk-node": "^4.13.23",
    "@electric-sql/pglite": "^0.3.2",
    "@nuxt/test-utils": "^3.21.0",
    "@nuxt/typescript-build": "^3.0.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.0.11",
    "msw": "^2.12.7",
    "typescript": "^5.3.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
}
